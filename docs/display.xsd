<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════
  display.xsd  —  v1.0
  ═══════════════════════════════════════════════════════════════════
  Defines the XML payload placed in:
    SaleToPOIRequest > DisplayRequest > DisplayOutput >
    OutputContent[OutputFormat="XHTML"] > OutputXHTML  (as Base64)

  Transport context (POIID, SaleID, ServiceID, ProtocolVersion…)
  is carried by the nexo MessageHeader and is NOT part of this schema.

  Content types supported in v1.0:
    <receipt>  — itemised purchase summary
    <qrCode>   — standalone QR code or barcode screen
    <image>    — standalone image screen
    <standby>  — idle/standby screen
    <waiting>  — waiting/progress screen
  ═══════════════════════════════════════════════════════════════════
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:bilt:display:v1"
           xmlns:d="urn:bilt:display:v1"
           xmlns:c="urn:bilt:common:v1"
           elementFormDefault="qualified">

    <xs:import namespace="urn:bilt:common:v1" schemaLocation="common.xsd"/>


    <!-- ═══════════════════════════════════════════
         Root element
         ═══════════════════════════════════════════ -->
    <xs:element name="displayPayload">
        <xs:complexType>
            <xs:sequence>
                <!-- Exactly one content type per payload -->
                <xs:choice>
                    <xs:element name="receipt" type="d:ReceiptType"/>
                    <xs:element name="qrCode"  type="d:QrCodeType"/>
                    <xs:element name="image"   type="d:ImageType"/>
                    <xs:element name="standby" type="d:StandbyType"/>
                    <xs:element name="waiting" type="d:WaitingType"/>
                </xs:choice>
            </xs:sequence>
            <!--
              Identifies the XSLT the terminal applies to render this payload.
              Examples: "receipt-qr.xslt", "receipt.xslt", "qr.xslt",
                        "barcode.xslt", "image.xslt", "standby.xslt",
                        "waiting.xslt"
              Kept as xs:string (not an enum) so new layouts can be introduced
              without a schema change.
            -->
            <xs:attribute name="layout"  type="xs:string" use="required"/>
            <xs:attribute name="version" type="xs:string" default="1.0"/>
        </xs:complexType>
    </xs:element>


    <!-- ═══════════════════════════════════════════
         Shared: HeaderFooterType
         Positional/structural elements used in
         <receipt> and <qrCode>. Not the same as
         DisplayType from common.xsd — these mark
         top/bottom positions in a content block,
         not general shopper messages.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="HeaderFooterType">
        <xs:sequence>
            <xs:element name="text" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         Shared: ImageType
         Used by: standalone <image>, <receipt> banner,
         and <lineItem> thumbnail.
         Content: base64-encoded binary (PNG, JPEG, etc.)
         ═══════════════════════════════════════════ -->
    <xs:complexType name="ImageType">
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary">
                <xs:attribute name="mediaType" type="xs:string" default="image/png"/>
                <xs:attribute name="altText"   type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         Shared: QrCodeType
         Used by: standalone <qrCode> and embedded
         in <receipt>.
         Symbology is controlled by the `type` attribute.
         Suggested values: "qr", "barcode128", "pdf417",
         "datamatrix"
         ═══════════════════════════════════════════ -->
    <xs:complexType name="QrCodeType">
        <xs:sequence>
            <xs:element name="header"       type="d:HeaderFooterType" minOccurs="0"/>
            <xs:element name="data"         type="xs:anyURI"/>
            <xs:element name="callToAction" type="xs:string"          minOccurs="0"/>
            <xs:element name="footer"       type="d:HeaderFooterType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="xs:string" default="qr"/>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         Shared: MoneyType
         Used by: <unitPrice>, <amount> throughout.
         Currency can be ISO 4217 code or display
         symbol (e.g. "USD" or "$").
         Optional <unit> for items sold by weight/volume
         (e.g. "lb", "kg", "oz", "ea", "gal").
         ═══════════════════════════════════════════ -->
    <xs:complexType name="MoneyType">
        <xs:sequence>
            <xs:element name="currency" type="xs:string"/>
            <xs:element name="value"    type="xs:decimal"/>
            <xs:element name="unit"     type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         Shared: LabeledAmountType
         A description + optional amount pair.
         Used by: <subtotal>, <total>, <totalDiscount>,
         <taxItem>, <taxTotal>.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="LabeledAmountType">
        <xs:sequence>
            <xs:element name="description" type="xs:string"   minOccurs="0"/>
            <xs:element name="amount"      type="d:MoneyType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         StandbyType
         Instructs the terminal to return to its
         idle/standby screen.
         The optional `theme` attribute selects a
         seasonal or branded visual variant
         (e.g. "christmas", "halloween").
         The optional <display> block (from common.xsd)
         allows a title and text lines to be shown
         on the standby screen.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="StandbyType">
        <xs:sequence>
            <xs:element name="display" type="c:DisplayType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="theme" type="xs:string" use="optional"/>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         WaitingType
         Shows a waiting/progress screen.
         Can be used standalone or embedded inside
         <receipt> (same pattern as <qrCode> and
         <image>).
         Uses the shared DisplayType from common.xsd
         for title and text lines.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="WaitingType">
        <xs:sequence>
            <xs:element name="display" type="c:DisplayType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         ReceiptType
         ═══════════════════════════════════════════ -->
    <xs:complexType name="ReceiptType">
        <xs:sequence>
            <!-- Optional banner image at the top of the receipt -->
            <xs:element name="image"     type="d:ImageType"         minOccurs="0"/>
            <!-- Optional QR/barcode embedded within the receipt -->
            <xs:element name="qrCode"    type="d:QrCodeType"        minOccurs="0"/>
            <!-- Optional waiting block embedded within the receipt -->
            <xs:element name="waiting"   type="d:WaitingType"       minOccurs="0"/>
            <!-- Section heading shown above the line items -->
            <xs:element name="header"    type="d:HeaderFooterType"  minOccurs="0"/>
            <!-- Line items -->
            <xs:element name="lineItems" type="d:LineItemsType"     minOccurs="0"/>
            <!-- Totals block -->
            <xs:element name="subtotal"  type="d:LabeledAmountType" minOccurs="0"/>
            <xs:element name="adjustments" type="d:AdjustmentsType"     minOccurs="0"/>
            <xs:element name="tax"       type="d:TaxType"           minOccurs="0"/>
            <xs:element name="total"     type="d:LabeledAmountType" minOccurs="0"/>
            <!-- Optional closing message -->
            <xs:element name="footer"    type="d:HeaderFooterType"  minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         LineItemsType  —  container
         ═══════════════════════════════════════════ -->
    <xs:complexType name="LineItemsType">
        <xs:sequence>
            <xs:element name="lineItem" type="d:LineItemType"
                        minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         SectionType  —  discount group applied to an item
         Groups one or more discount descriptions under a
         shared label (e.g., "Discount", "CLEARANCE").
         ═══════════════════════════════════════════ -->
    <xs:complexType name="SectionType">
        <xs:sequence>
            <xs:element name="label" type="xs:string"/>
            <xs:element name="items" type="d:SectionItemsType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SectionItemsType">
        <xs:sequence>
            <xs:element name="item" maxOccurs="unbounded" type="d:SectionItemType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SectionItemType">
        <xs:sequence>
            <xs:element name="description" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         LineItemType  —  single row
         ═══════════════════════════════════════════ -->
    <xs:complexType name="LineItemType">
        <xs:sequence>
            <!--
              All child elements are optional; meaningful ones
              depend on `kind`:

              kind="item"      — description, subtitle, image,
                                 quantity, unitPrice, amount,
                                 originalAmount, discount(s)
              kind="heading"   — description only (accepted but
                                 not rendered on terminal)
              kind="discount"  — description, amount (negative)
              kind="return"    — description, quantity, unitPrice,
                                 amount (negative)
              kind="void"      — description, quantity, unitPrice,
                                 amount (negative); rendered with
                                 red text and "Voided from
                                 transaction" label
              kind="separator" — no children (accepted but not
                                 rendered on terminal)
              kind="spacer"    — no children (accepted but not
                                 rendered on terminal)
            -->
            <xs:element name="image"          type="d:ImageType"        minOccurs="0"/>
            <xs:element name="description"    type="xs:string"          minOccurs="0"/>
            <xs:element name="subtitle"       type="xs:string"          minOccurs="0"/>
            <xs:element name="quantity"       type="xs:decimal"         minOccurs="0"/>
            <xs:element name="unitPrice"      type="d:MoneyType"        minOccurs="0"/>
            <xs:element name="amount"         type="d:MoneyType"        minOccurs="0"/>
            <xs:element name="originalAmount" type="d:MoneyType"        minOccurs="0"/>
            <xs:element name="section"       type="d:SectionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="kind" type="d:LineItemKindType" default="item"/>
    </xs:complexType>

    <xs:simpleType name="LineItemKindType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="item"/>
            <xs:enumeration value="heading"/>
            <xs:enumeration value="discount"/>
            <xs:enumeration value="return"/>
            <xs:enumeration value="void"/>
            <xs:enumeration value="separator"/>
            <xs:enumeration value="spacer"/>
        </xs:restriction>
    </xs:simpleType>


    <!-- ═══════════════════════════════════════════
         AdjustmentsType  —  order-level discounts
         Contains discounts that apply to the entire
         order (loyalty rewards, coupons, etc.) rather
         than individual items.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="AdjustmentsType">
        <xs:sequence>
            <xs:element name="adjustmentItem" type="d:LabeledAmountType"
                        minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ═══════════════════════════════════════════
         TaxType  —  tax breakdown
         Contains only tax-related items.
         ═══════════════════════════════════════════ -->
    <xs:complexType name="TaxType">
        <xs:sequence>
            <xs:element name="taxItem"  type="d:LabeledAmountType"
                        minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="taxTotal" type="d:LabeledAmountType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>