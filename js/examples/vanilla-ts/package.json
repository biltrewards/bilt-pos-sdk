{
  "name": "vanilla-ts",
  "version": "0.0.0",
  "private": true,
  "description": "A framework-free browser register for the Bilt POS SDK: Vite + TypeScript and plain DOM over @bilt/pos-sdk and the Terminal Bridge.",
