  },
  "dependencies": {
    "@bilt/pos-protocol": "workspace:*",
    "@bilt/pos-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "jsdom": "^26.1.0",
    "vite": "^8.3.3"
  }
}
