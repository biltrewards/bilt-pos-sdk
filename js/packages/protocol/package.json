{
  "name": "@bilt/pos-protocol",
  "version": "0.0.0",
  "description": "Types and a typed fetch client generated from the Bilt POS Session Protocol (schema/session-protocol).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biltrewards/bilt-pos-sdk.git",
    "directory": "js/packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.1",
    "openapi-typescript": "^7.13.0",
    "@types/node": "^20.19.0"
  }
}
