{
  "name": "nexo-codegen",
  "private": true,
  "scripts": {
    "generate:java": "node generate-nexo-java.js",
    "generate:openapi": "node generate-openapi.js",
    "generate:api-reference": "node generate-openapi.js && npx @redocly/cli build-docs ../docs/openapi.yaml -o ../docs/api-reference.html --theme.openapi.schemaDefinitionsTagName=Schemas --theme.openapi.hideDownloadButton=true",
    "lint:session-protocol": "npx @redocly/cli lint session-protocol/openapi.yaml --config session-protocol/redocly.yaml",
    "bundle:session-protocol": "npx @redocly/cli bundle session-protocol/openapi.yaml --config session-protocol/redocly.yaml -o session-protocol/dist/openapi.bundled.yaml",
    "generate:session-protocol-reference": "pnpm --dir ../js generate:reference"
  },
  "devDependencies": {
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.1",
    "@redocly/cli": "^2.38.0",
    "js-yaml": "^4.3.2",
    "quicktype": "26.0.0"
  },
  "overrides": {
    "vm2": "3.12.2",
    "brace-expansion": "5.0.12",
    "stream-json": "3.7.0",
    "moment": "2.31.0"
  }
}
